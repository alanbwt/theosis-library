{"textId": {"genre": "L", "category": 1, "index": 1}, "classification": "Ancient", "stage": "Standard Babylonian", "version": "", "name": "III", "order": 12, "manuscripts": [{"id": 1, "siglumDisambiguator": "1", "oldSigla": [], "museumNumber": "Ist-B.116", "accession": "", "periodModifier": "None", "period": "Neo-Babylonian", "provenance": "Babylon", "type": "Library", "notes": "Museum number courtesy of D. Schwemer.", "colophon": "", "unplacedLines": "", "references": [{"id": "RN435", "type": "COPY", "pages": "pls. 4, 9-10", "notes": "", "linesCited": [], "document": {"id": "RN435", "author": [{"given": "Wilfred G.", "family": "Lambert"}, {"given": "Alan R.", "family": "Millard"}], "title": "Atra-ḫasīs. The Babylonian Story of the Flood", "publisher": "Clarendon Press", "publisher-place": "Oxford", "type": "book", "citation-label": "RN435", "issued": {"date-parts": [[1969]]}}}], "joins": [], "isInFragmentarium": false}, {"id": 2, "siglumDisambiguator": "1", "oldSigla": [], "museumNumber": "K.4539", "accession": "", "periodModifier": "None", "period": "Neo-Assyrian", "provenance": "Nineveh", "type": "Library", "notes": "Lambert & Millard 1969: Ms R (K.4539); Lambert & Millard 1969: Ms P (K.7816); probably same tablet as K.14697 (p. 41)", "colophon": "", "unplacedLines": "", "references": [{"id": "RN432", "type": "COPY", "pages": "pl. 65", "notes": "K.4539", "linesCited": [], "document": {"id": "RN432", "author": [{"family": "Lambert", "given": "Wilfred G."}], "title": "Babylonian Wisdom Literature", "container-title-short": "BWL", "publisher": "Clarendon Press", "publisher-place": "Oxford", "type": "book", "citation-label": "RN432", "issued": {"date-parts": [[1960]]}}}, {"id": "RN3094", "type": "COPY", "pages": "688", "notes": "only K.7816", "linesCited": [], "document": {"id": "RN3094", "author": [{"family": "Macmillan", "given": "K.D."}], "title": "Some Cuneiform Tablets bearing on the religion of Babylonia and Assyria", "container-title": "Beiträge zur Assyriologie", "container-title-short": "BA", "collection-number": "5/V", "page": "531-712", "type": "article-journal", "citation-label": "RN3094", "issued": {"date-parts": [[1906]]}, "volume": "5"}}, {"id": "CT0046", "type": "COPY", "pages": "no. 13", "notes": "", "linesCited": [], "document": {"id": "CT0046", "author": [{"family": "Lambert", "given": "Wilfred G."}, {"family": "Millard", "given": "Alan R."}], "issued": {"date-parts": [[1965]]}, "collection-title": "Cuneiform Texts from Babylonian Tablets in the British Museum", "title": "Cuneiform Texts from Babylonian Tablets in the British Museum. Part XLVI", "container-title-short": "CT", "collection-number": "46", "type": "book", "publisher-place": "London", "publisher": "Harrison"}}, {"id": "RN419", "type": "COPY", "pages": "75", "notes": "K.17752", "linesCited": [], "document": {"id": "RN419", "author": [{"family": "Lambert", "given": "Wilfred G."}], "title": "New Fragments of Babylonian Epics", "container-title": "Archiv für Orientforschung", "page": "71-82", "type": "article-journal", "citation-label": "RN419", "issued": {"date-parts": [[1980]]}, "volume": "27", "URL": "https://www.jstor.org/stable/41636418"}}, {"id": "fromebllab0037", "type": "EDITION", "pages": "78-80", "notes": "K.5902", "linesCited": [], "document": {"id": "fromebllab0037", "title": "New Fragments of Atramḫasīs", "container-title": "Kaskal", "type": "article-journal", "issued": {"date-parts": [[2023]]}, "volume": "20", "DOI": "10.1400/296867", "page": "77-81", "author": [{"family": "Rozzi", "given": "Geraldina"}]}}, {"id": "fromebllab0037", "type": "COPY", "pages": "81", "notes": "K.5902", "linesCited": [], "document": {"id": "fromebllab0037", "title": "New Fragments of Atramḫasīs", "container-title": "Kaskal", "type": "article-journal", "issued": {"date-parts": [[2023]]}, "volume": "20", "DOI": "10.1400/296867", "page": "77-81", "author": [{"family": "Rozzi", "given": "Geraldina"}]}}, {"id": "wasserman2020flood", "type": "DISCUSSION", "pages": "16", "notes": "", "linesCited": [], "document": {"id": "wasserman2020flood", "author": [{"family": "Wasserman", "given": "Nathan"}], "title": "The Flood: The Akkadian Sources. A New Edition, Commentary, and a Literary Discussion", "publisher": "Peeters", "publisher-place": "Leuven/Paris/Bristol", "collection-title": "Orbis Biblicus et Orientalis", "type": "book", "citation-label": "wasserman2020flood", "issued": {"date-parts": [[2020]]}, "collection-number": "290", "DOI": "10.5167/uzh-186591"}}], "joins": [], "isInFragmentarium": false}, {"id": 3, "siglumDisambiguator": "1", "oldSigla": [], "museumNumber": "IM.124649", "accession": "", "periodModifier": "None", "period": "Neo-Babylonian", "provenance": "Sippar", "type": "Quotation", "notes": "", "colophon": "", "unplacedLines": "", "references": [{"id": "RN118", "type": "COPY", "pages": "165, 167, 169", "notes": "", "linesCited": [], "document": {"id": "RN118", "author": [{"family": "George", "given": "Andrew R."}, {"family": "Rawi", "given": "Farouk N.H.", "non-dropping-particle": "al"}], "title": "Tablets From the Sippar Library VI. Atra-ḫasīs", "container-title": "Iraq", "page": "147-190", "type": "article-journal", "citation-label": "RN118", "issued": {"date-parts": [[1996]]}, "volume": "58", "DOI": "10.2307/4200426"}}, {"id": "RN118", "type": "PHOTO", "pages": "164, 166, 170", "notes": "", "linesCited": [], "document": {"id": "RN118", "author": [{"family": "George", "given": "Andrew R."}, {"family": "Rawi", "given": "Farouk N.H.", "non-dropping-particle": "al"}], "title": "Tablets From the Sippar Library VI. Atra-ḫasīs", "container-title": "Iraq", "page": "147-190", "type": "article-journal", "citation-label": "RN118", "issued": {"date-parts": [[1996]]}, "volume": "58", "DOI": "10.2307/4200426"}}], "joins": [], "isInFragmentarium": false}], "uncertainFragments": [], "lines": [{"number": "1", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [mām]a | pâša | tēpušam-ma", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "7'a", "atf": "[{d}ma-ma pa-a-š]u* te?#-pu-ša-a[m-ma]\n$ line continues\n#note: The line numeration of MS BabNB1 follows the traces visible on the photograph (@bib{PhBab@1805}); the copy by @bib{RN435@pl. 4} begins with l. o i 4′.", "omittedWords": []}, {"manuscriptId": 3, "labels": ["r"], "number": "60", "atf": "[{d}ma-m]a pa-a-šu te-pu-ša-am-ma", "omittedWords": []}], "intertext": "Chapter III of the Standard Babylonian version is primarily known from a Nineveh manuscript (NinNA1), with newly discovered fragments restoring lines 28-39. A Babylonian manuscript (BabNB1) restores the initial section (@bib{fromebllab0037}). While no ‘Sippar Library’ manuscript exists, the manuscripts of previous and following chapters suggest that version likely paralleled OB @i{Atramḫasīs} I 231-355."}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: Mama made ready to speak"}, {"number": "2", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [tazzakkar | ana ilī | ahhēša]", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "7'b", "atf": "[x x x x x x x x]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: [And said to the gods her brothers,]"}, {"number": "3", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [... | dullak]unu? | a[mēla? | ...]\n#note: It seems clear that the Standard Babylonian version of the speech of Mami, preserved in a tablet from Babylon known only from the excavation photo (BabNB1) and from a fragmentary manuscript from Nineveh, was very different from its Old Babylonian counterpart (OB I 233–239). Some of the lines are similar, but appear in a different order, as it occurs in the repetition of the passage in the OB version (OB II 378–380).", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "8'", "atf": "[x x (x x x) du-ul-la?-k]u-nu a*#-[me-la? x x x]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o", "ii"], "number": "1'", "atf": "[...] x x [x]\n#note: The traces cannot be reconciled with a verb @akk{e-mi-id}.", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: [@i{I have imposed}] your [… @i{forced labor}] on @i{man}."}, {"number": "4", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [(...) ultu?] ūmi? | annî || ilī | ulla[l?]", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "9'", "atf": "[(x x x) ul-tu?] u₄?#-mi an-ni-i i*-lu*# u₂?#-[ul-la-al-la?]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o", "ii"], "number": "2'", "atf": "[(x x x x x) x x x x x x x x] u₂#-ul-la-l[a?]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: [@i{From}] this @i{day onwards I will set} the gods @i{free}!"}, {"number": "5", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [...] ... | rigma | ana amēlūti", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "10'", "atf": "[x x x (x x x)] x ri*#-ig*#-ma*# a*#-[na x x x x]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o", "ii"], "number": "3'", "atf": "[x x x (x x x) x x x x x x] a#-me-lu-ti₃", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: “[@i{You have bestowed}] clamor upon humankind."}, {"number": "6", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [tupšikki?] (|) ilī? || amēla | ēmid", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "11'", "atf": "[tu-up-ši-ik-ki?] i?-lu? a*#-me₂*#-lu?# [x x x (x x)]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o", "ii"], "number": "4'", "atf": "[x x x x x x x a-me-l]am? e-mi-id", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: “I have imposed [@i{the drudgery}] @i{of god} on man."}, {"number": "7", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [...] ... | ana amēlūti", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "12'", "atf": "[x x x (x x x x)] x-DU?#-pa?#-tu₄? a?#-[na? x x (x x)]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o", "ii"], "number": "5'", "atf": "[x x x x x x x x] a#-na# a-me-lu-ti₃", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: […] … for mankind"}, {"number": "8", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [ila | taṭb]uha | qadu (|) ṭēmīšu", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "13'", "atf": "[DINGIR ta-aṭ-b]u-ha qa₂-du# [ṭ]e₃-e#-[mi-šu]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o", "ii"], "number": "6'", "atf": "[x x x x x qa₂-d]u-um ṭe₃-mi-šu", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: “[You have] slaughtered [the god], along with his inspiration.”"}, {"number": "9", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [ša? māma? | k]īam | qabâša\n#note: The signs in BabNB1 do not allow a reading @akk{[an-n]a-a-am} @i{qabâša} to match the Old Babylonian version (OB I 240), since the sign before @akk{A} has four horizontals followed by a vertical. The phrase @i{kiam qabâša}, “thus was her speech,” seems to be unique. The restoration adopted ", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "14'", "atf": "[ša₂? {d}ma-ma? k]i*-a#-am*# qa₂#-ba?#-[ša?]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o", "ii"], "number": "7'", "atf": "[x x x ki-a-a]m qa-ba-ša", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: Thus was the speech [@i{of Mama}]."}, {"number": "10", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [ilū? | iddarrū-ma || i]ššiqū | šēpīša\n#note: It is assumed that the SB version makes explicit the implicit subject of OB I 241.", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "15'", "atf": "[x x x x x i]š*-ši-qu₂ š[e-p]i-[(i)-ša]\n$ single ruling", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o", "ii"], "number": "8'", "atf": "[x x x x x iš]-ši#-qu₂ še-pi-ša\n$ single ruling", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: [@i{The gods ran together}] and kissed her feet, (saying,)"}, {"number": "11", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [pānā-mi | m]āma | nišassīki", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "16'", "atf": "[x x x {d}]ma*-ma# ni-ša*#-as?#-[si-ki]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o", "ii"], "number": "9'", "atf": "[x x x {d}ma-m]a ni-ša-si-ki", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: [‘Formerly] we used to call you [Ma]mi,"}, {"number": "12", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [inanna | bē]let (|) kala (|) ilī | lū šumki", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "17'", "atf": "[x x x x be]-le?#-[e]t? k[a*-l]a* i-li*# lu*#-[u₂ x x]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o", "ii"], "number": "10'", "atf": "[x x x x be-l]et ka-la i-li lu šum-ki", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: Now let your name be Mistress-of-All-the-Gods"}, {"number": "13", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [īterb]ū | ana bīt (|) šīmti", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "18'", "atf": "[x x x x x x x š]i*-im*-[ti]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o", "ii"], "number": "11'", "atf": "[i-te-er-b]u a-na E₂ ši-im-ti", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: [They enter]ed the house of destiny"}, {"number": "14", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [nin]šīku | ea || erištu | māma", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "19'", "atf": "[x x x x x x x e-ri]š-t[u₄] {d*#}ma*-[ma]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o", "ii"], "number": "12'", "atf": "[{d}nin]-ši-ku₃ {d}e₂-a e-riš-tu {d}ma#-ma", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: Did prince Ea (and) wise Mami."}, {"number": "15", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [ša]ssurātu | puhhurā-ma", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "20'", "atf": "[x x x x x x x x x x x]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o", "ii"], "number": "13'", "atf": "[ša₃-a]s-su-ra-a-tu₄ pu-uh₂-hu-ra-ma", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: With the birth-goddesses assembled"}, {"number": "16", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [ṭiṭ]ṭa | ikabbasa | am-mahrīša\n#note: The reading @akk{ma-ah-ri-ša} follows @bib{RN435@60}, who take @i{am} as the ventive particle (@i{i-kab-ba-sa-am}). It seems more likely that it is the preposition @i{ana}. @bib{RN2720@324a} (and @bib{RN7444@425 fn. 1} and @bib{soden1978erste@92} and ) read the line as @akk{i-kab-ba-sa-am-ma ih-ri-ša}, from @i{ḫarāšu}(@i{um}) I “im Kindbett liegen” (“…und legte sich ins Kindbett,” the subject being the birth-goddesses). This reading is ruled out by @bib{RN1445@158} on the basis of SB III 18 (@i{āšib mahrīš}[@i{a}]); see also the arguments in favor of -@akk{sa-am ma-ah}- by @bib{RN744@113 fn. 23} and @bib{RN603@57 fn. 96}.", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "21'", "atf": "[x x x x x x x x x x x x x]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o", "ii"], "number": "14'", "atf": "[ṭi-i]ṭ-ṭa i-kab-ba-sa am-ma-ah-ri-ša", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: He trod the clay in her presence."}, {"number": "17", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [š]ī | šipta | ittanaddi\n#note: @bib{RN603@47} interprets the @i{tan}-Infix in @i{ittanaddi} as distributive succession (“Sie (aber) brachte in einem fort die Beschwörung hervor”). ", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "22'", "atf": "[x x x x x x x x x x]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o", "ii"], "number": "15'", "atf": "[ši]-i# ši-ip-ta it-ta-na-an-di", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: She kept reciting the incantation,"}, {"number": "18", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ušamnāši | ea || āšib | mahrīš[a]", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "23'", "atf": "[x x x x x x x] a#-ši-[ib x x]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o", "ii"], "number": "16'", "atf": "u₂#-šam-na-ši {d}e₂-a a-ši-ib ma-ah-ri-š[a]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: Ea, seated before her, was prompting her."}, {"number": "19", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ištū-ma | igmuru | šipass[a]", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "24'", "atf": "[x x x x x x (x x x x)-r]i?-su?# [x x (x x)]\n$ rest of column broken", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o", "ii"], "number": "17'", "atf": "[i]š-tu-ma ig-mu-ru ši-pa-as-s[a₆]\n$ single ruling", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: After she had finished her incantation,"}, {"number": "20", "oldLineNumbers": [], "variants": [{"reconstruction": "%n kerṣī | erbēšeret | uktarri[ṣ]", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii"], "number": "18'", "atf": "ke#-er-ṣi 14 uk-ta-ar-ri-i[ṣ]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: She nipped off fourteen pieces of clay."}, {"number": "21", "oldLineNumbers": [], "variants": [{"reconstruction": "%n sebet | kerṣī | ana imitti", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii"], "number": "19'", "atf": "7# ke-er-ṣi a-na i-mi-it-t[i]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: Seven she put on the right,"}, {"number": "22", "oldLineNumbers": [], "variants": [{"reconstruction": "%n sebet | kerṣī || ana šumēli | išk[un]", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii"], "number": "20'", "atf": "7# ke-er-ṣi a-na šu-me-li iš-k[un]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: Seven on the left."}, {"number": "23", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [ina bi]rīšunu | ittadi | libitta", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii"], "number": "21'", "atf": "[i-na bi]-ri#-šu₂#-nu it-ta-di li-bit-ti#", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: Between them she placed the brick"}, {"number": "24", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [...] ... (|) abunnati | ...\n#note: @bib{soden1978erste@92} reads @i{uš}[-]@i{b}[@i{a}?] at the end of the line.", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii"], "number": "2
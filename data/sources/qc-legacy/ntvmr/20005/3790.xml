  <text xml:lang="grc"><body><pb n="182v" type="folio"/><cb n="1"/><lb/><div type="book" n="B03"><div type="chapter" n="B03K1"><ab n="B03K1V1"><w>επειδηπερ</w> <w>πολλοι</w> <w>επεχειρησαν</w> <w>ανα<lb break="no"/>ταξασθαι</w> <w>διηγησιν</w> <w>περι</w> <w>των</w><lb/><w>πεπληροφορημενων</w> <w>εν</w> <w>ημειν</w><lb/><w>πραγματων</w></ab> <ab n="B03K1V2"><w>καθα</w> <w>παρεδοσαν</w> <w>ημειν</w><lb/><w>οι</w> <w>απ</w> <w>αρχης</w> <w>αυτοπται</w> <w>και</w> <w>υπηρεται</w><lb/><w>γενομενοι</w> <w>του</w> <w>λογου</w></ab> <ab n="B03K1V3"><w>εδοξε</w> <w>καμοι</w><lb/><w>παρηκολουθηκοτι</w> <w>ανωθεν</w> <w>πασιν</w><lb/><w>ακριβως</w> <w>καθεξης</w> <w>σοι</w> <w>γραψαι</w><lb/><w>κρατιστε</w> <w>θεοφιλε</w></ab> <ab n="B03K1V4"><w>ινα</w> <w>επιγνως</w><lb/><w>περι</w> <app><rdg type="orig" hand="firsthand"><w>των</w></rdg><rdg type="corr" hand="corrector1"><w>ων</w></rdg></app><note type="local" xml:id="B03K1V4-05-1">Scrivener s.m.</note> <w>κατηχηθης</w> <w>λογων</w> <w>την</w> <w>ασφαλειαν</w><lb/></ab> <ab n="B03K1V5"><w>εγενετο</w> <w>εν</w> <w>ταις</w> <w>ημεραις</w> <w>ηρωδου</w><lb/><w>του</w> <w>βασιλεως</w> <w>της</w> <w>ιουδαιας</w> <w>ιερευς</w><lb/><w>τις</w> <w>ονοματι</w> <w>ζαχαριας</w> <w>εξ</w> <w>εφημεριας</w><lb/><w>αβια</w><pc>·</pc> <w>και</w> <w>γυνη</w> <w>αυτω</w> <w>εκ</w> <w>των</w> <w>θυγατερων</w><lb/><w>ααρων</w> <w>και</w> <w>το</w> <w>ονομα</w> <w>αυτης</w> <w>ελεισαβεθ</w><lb/></ab> <ab n="B03K1V6"><w>ησαν</w> <w>δε</w> <w>δικαιοι</w> <w>αμφοτεροι</w> <w>ενωπιον</w><lb/><w>του</w> <w><abbr type="nomSac"><hi rend="overline">θυ</hi></abbr></w> <w>πορευομενοι</w> <w>εν</w> <w>πασαις</w><lb/><w>ταις</w> <w>εντολαις</w> <w>και</w> <w>δικαιωμασιν</w> <w>του</w> <w><abbr type="nomSac"><hi rend="overline">κυ</hi></abbr></w><lb/><w>αμεπτοι</w></ab> <ab n="B03K1V7"><w>και</w> <w>ουκ</w> <w>ην</w> <w>αυτοις</w> <w>τεκνον</w><lb/><w>καθοτι</w> <w>ην</w> <w>η</w> <w>ελισαβεθ</w> <w>στειρα</w><pc>·</pc><lb/><w>και</w> <w>αμφοτεροι</w> <w>ησαν
{"textId": {"genre": "L", "category": 1, "index": 10}, "classification": "Ancient", "stage": "Neo-Assyrian", "version": "Sultantepe", "name": "-", "order": 5, "manuscripts": [{"id": 1, "siglumDisambiguator": "1", "oldSigla": [], "museumNumber": "SU-1951.19.A", "accession": "", "periodModifier": "None", "period": "Neo-Assyrian", "provenance": "Ḫuzirina", "type": "Library", "notes": "", "colophon": "", "unplacedLines": "", "references": [{"id": "RN2069cc", "type": "COPY", "pages": "pl. XXVII–XXVIII no. 23", "notes": "", "linesCited": [], "document": {"id": "RN2069cc", "author": [{"family": "Gurney", "given": "Oliver R."}, {"family": "Finkelstein", "given": "Jacob J."}], "title": "The Sultantepe Tablets I", "publisher": "The British Institute of Archaeology at Ankara", "publisher-place": "London", "container-title-short": "STT", "collection-number": "1", "type": "book", "citation-label": "RN2069cc", "issued": {"date-parts": [[1957]]}, "collection-title": "Occasional Publications of the British Institute of Archaeology at Ankara"}}], "joins": [], "isInFragmentarium": false}, {"id": 2, "siglumDisambiguator": "2", "oldSigla": [], "museumNumber": "SU-1952.187", "accession": "", "periodModifier": "None", "period": "Neo-Assyrian", "provenance": "Ḫuzirina", "type": "Library", "notes": "", "colophon": "", "unplacedLines": "", "references": [{"id": "RN2069cc", "type": "COPY", "pages": "pl. XXIX no. 25", "notes": "", "linesCited": [], "document": {"id": "RN2069cc", "author": [{"family": "Gurney", "given": "Oliver R."}, {"family": "Finkelstein", "given": "Jacob J."}], "title": "The Sultantepe Tablets I", "publisher": "The British Institute of Archaeology at Ankara", "publisher-place": "London", "container-title-short": "STT", "collection-number": "1", "type": "book", "citation-label": "RN2069cc", "issued": {"date-parts": [[1957]]}, "collection-title": "Occasional Publications of the British Institute of Archaeology at Ankara"}}], "joins": [], "isInFragmentarium": false}], "uncertainFragments": [], "lines": [{"number": "a+1", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [...] | itta[lak (...)]", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "1'", "atf": "[...] it#-ta#-[lak (x)]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: […] @i{he left}."}, {"number": "a+2", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [... | ūmē | r]abûte | iṣme[d]", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "2'", "atf": "[... u₄-me r]a-bu-te iṣ-me-[ed]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: […] harnessed the great storms."}, {"number": "a+3", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [...] illik || tibûte | išku[n]", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "3'", "atf": "[...] il-lik ti-bu-te iš-ku[n]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: [@i{He mounted his chariot and}] marched to levy (his army,)"}, {"number": "a+4", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [... | ana qere]b (|) ṣēlūti | illik", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "4'", "atf": "[x x x qe₂-re]b ṣe-lu-ti il-lik", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "1'", "atf": "[x x x] x [x x x x x x]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: […] he headed […] to the centre of the battle."}, {"number": "a+5", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [ina pā]n ... ummānāti | umdaʾʾir", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "5'", "atf": "[...] um-ma-na-ti um-da-ir", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "2'", "atf": "[x pa]-an x x x [x x x x x x x]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: @i{In front of} … he deployed (his) hosts:"}, {"number": "a+6", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [itti] šūt[e | na]špante | elṭūti", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "6'", "atf": "[x x x x x na]-aš-pan-te el-ṭu-ti", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "3'", "atf": "[x x] {im}U₁₈.L[U na-aš-pan-te el-ṭu-ti]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: With the south wind, (he deployed) a devastating flood;"}, {"number": "a+7", "oldLineNumbers": [], "variants": [{"reconstruction": "%n itti iltāni | ešâtu || dalihtu | igammarā", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "7'", "atf": "[x x x x x e₂-ša₂-a-t]u₂ dal-ih-ta i-ga-ma-ri", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "4'", "atf": "it#-ti# {im}SI.SA₂ e?#-ša₂#-a#-[tu x x x x x x x]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: With the north wind, confusion and chaos shall annihilate (them)!"}, {"number": "a+8", "oldLineNumbers": [], "variants": [{"reconstruction": "%n itti šadê | reddu | dannu", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "8'", "atf": "[x x x x x] red-du dan-nu", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "5'", "atf": "it-ti {im}KUR.RA [x x x x]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: With the east wind, a fierce tempest;"}, {"number": "a+9", "oldLineNumbers": [], "variants": [{"reconstruction": "%n itti amurre | išāt (|) nable | iqammûšunu", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "9'", "atf": "[x x x x x i]-ša₂-te nab*-li i*-qa-mu-šu₂-nu\n#note: Collation Gurney @i{apud} @bib{RN555@127}", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "6'", "atf": "it-ti {im}MAR.TU# i#-šat# na[b-li x x x x x]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: With the west wind, the fire of flames shall burn them!"}, {"number": "a+10", "oldLineNumbers": [], "variants": [{"reconstruction": "%n išāt (|) anqulle | uštanahhazū", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "10'", "atf": "[x x x an-qul-l]i uš-ta-ne₂-eh-<ha>-zu", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "7'", "atf": "i-ša₂#-at an-qu-ul-li uš-ta#-na#-ah-[h]a?-[zu]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: The heat of the fiery glare shall set them aglow!"}, {"number": "a+11", "oldLineNumbers": [], "variants": [{"reconstruction": "%n išāt | nable | iqammûšunu", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "11'", "atf": "[x x x x x] i-qa-mu-šu₂-nu", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "8'", "atf": "i-ša₂-at# nab-li i#-qa-m[u]-šu₂#", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: The heat of the flame shall burn them!"}, {"number": "a+12", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ... | ihabbubū | birqū", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "12'", "atf": "[x x x x x] i-hab-bu-bu bir-qu", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "9'", "atf": "i#-x-qal?#-lu-šu i-hab-bu#-bu [b]ir-[qu]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: … lightning resounded."}, {"number": "a+13", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [nanz]uz | ninurta || anzâ | ana kašādi", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "13'", "atf": "[na-zu-u]z-zu {d}nin-urta# an-za-a ina ka-ša₂-di", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "10'", "atf": "[na-z]u-u[z] {d}nin-urta an-za-a a-na ka#-ša₂#-di#", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: Ninurta was preparing to catch Anzû:"}, {"number": "a+14", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [...] ... | taqribti | kulli | issâ", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "14'", "atf": "[x x x (x)-b]u taq-rib-ti kul-[l]i is-sa-[a]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "11'", "atf": "[x x x x ta]q-rib-ti [kul-l]i is-sa-[a]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: He ordered … to perform a sacrifice,"}, {"number": "a+15", "oldLineNumbers": [], "variants": [{"reconstruction": "%n asakka | rēšīšu | ušaqqi", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "15'a", "atf": "{d#}a#-[s]ak-ki °\\re°-<ša₂>-a-su u₂-š[aq]-qi\n$ line continues", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "12'", "atf": "[{d}a-sak-k]i re-ša₂-a-š[u] u₂-šaq-q[i₂]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: He turned his attention to the Asakku:"}, {"number": "a+16", "oldLineNumbers": [], "variants": [{"reconstruction": "%n īnā | (ša) ninurta | īṭâ", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "15'b", "atf": "IGI# {d#}nin#-urta# i#-[ṭi]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "13'", "atf": "[i?-nu?]-u₂ ša# {d#}[ni]n-urta i-ṭa-[a]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: Ninurta’s eyes darkened."}, {"number": "a+17", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ina šamê | ša āni | ana elêšu", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "16'a", "atf": "ina AN-e ša₂ {d}a-nu ana e-le-š[u₂]\n$ line continues", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "14'", "atf": "[x x x x] {d#}a-nu [a]-na e-le-[šu₂]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: To go up to the sky of Anu,"}, {"number": "a+18", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [išt]aru | ēteli | šaddâ[ša]", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "16'b", "atf": "[x x x x x x x x]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "15'", "atf": "[{d}eš₁₈-t]ar₂ e-te-li šad-da#-[ša₂]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: The goddess left for her mountain."}, {"number": "a+19", "oldLineNumbers": [], "variants": [{"reconstruction": "%n idki | ummānšu || ... | ikṣur", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "17'", "atf": "id-ki um-{+ma}man-šu [x x x x x x x]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "16'", "atf": "[x x] um-man-šu (x) x-šu ik-ṣur# [(x)]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: He summoned his hosts and assembled …:"}, {"number": "a+20", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ina hamuttē-ma | qarrādu || ig[guš | šaddâšu]", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "18'", "atf": "ina ha-mut-te-ma UR.SAG i[g-gu-uš x x x]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "17'", "atf": "[x ha-mut-te-m]a qar-[ra-d]u ig#-[gu-uš (x x x)]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: With haste the warrior departed [to his mountain]."}, {"number": "a+21", "oldLineNumbers": [], "variants": [{"reconstruction": "%n melammē | ezzūte | iktum[šunu]", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "19'", "atf": "me-lam-me ez-zu-te [x x x x]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "18'", "atf": "[me]-lam#-me# ez#-zu-te ik#-tum₃#-[šu-nu]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: He covered [them] with his wrathful auras,"}, {"number": "a+22", "oldLineNumbers": [], "variants": [{"reconstruction": "%n hurbāše | qardūte | usahh[irš]u[nu]", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "20'", "atf": "hur-ba-še qar-du#-t[e x x x x x]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "19'", "atf": "hur#-ba#-še# qar-du-te u₂-sah-h[ir?-š]u?-[nu]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: The fear of their heroism put them to flight,"}, {"number": "a+23", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ezzat (|) namurratīšu | m[āt]a | iktum", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "21'", "atf": "ez-za-at na-mur-rata-šu ma#-a#-[tu₂ x x]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "20'", "atf": "ez-za-at na#-mur-ra-ti-šu m[a-a-t]u ik-tum₃", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: The wrath of his glory covered the land,"}, {"number": "a+24", "oldLineNumbers": [], "variants": [{"reconstruction": "%n rašubbat (|) melammēšu | usahhip || šadê | h[u]ršāni", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "22'", "atf": "ra-šub-bat me-lam-me-šu u₂-sa-hi-i[p x x x x x]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "21'", "atf": "ra-šub-bat me-lam-me#-šu u₂-sah-hi-pa KUR-MEŠ-e h[u]r#-ša₂#-ni", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: The terror of his aura covered mountains and hills."}, {"number": "a+25", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ina tarīki | īnīšu | itbalšu", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "23'a", "atf": "ina ta-ri-ki# [I]GI+MIN-šu₂ it-bal-šu\n$ line continues", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "22'", "atf": "ina ta#-ri#-ki I[GI]+MIN-šu₂ it-bal-šu", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: With darkness he took away (the light of) his eyes"}, {"number": "a+26", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ūmīša | itbala || ekletu | ēteli", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "23'b", "atf": "u₄-mu-ša₂ i[t-ba-la x x x x x x x]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "23'", "atf": "[u₄-m]u-ša₂ it-ba-la ik#-le?#-e#-te e-te-li", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: He removed his light and darkness arose."}, {"number": "a+27", "oldLineNumbers": [], "variants": [{"reconstruction": "%n anzâ | idluh-ma || napšass[u] | ittikis", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "24'", "atf": "an-za-a i[d]-lu-uh-ma nap-šat-s[u x x x]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "24'", "atf": "[an-za]-a# id-lu-uh-m[a nap-šat-su] it-ti-kis", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: Having confused (thus) Anzû, he cut his throat."}, {"number": "a+28", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ina rigim (|) qarrādi || išāta | ultāhiz", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "25'", "atf": "ina ri-gim q[a]r*-ra-du i-ša-te u[l-ta-hi-iz]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "25'", "atf": "[x ri-gi]m qar#-ra#-du# i-[ša₂-te] ul-ta#-hi#-iz", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: At the voice of the hero the fire was kindled,"}, {"number": "a+29", "oldLineNumbers": [], "variants": [{"reconstruction": "%n irubbū | ilū (|) erṣeti | ašarēssunu", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "26'", "atf": "i-ru-ub-bu DINGIR-MEŠ KI-ti₃ a-š[a₂-red-su-nu]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "26'", "atf": "[i-ru-ub-b]u DINGIR-MEŠ# K[I-ti₃ a]-ša₂-red-su#-nu", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: The gods of the earth trembled before their hero,"}, {"number": "a+30", "oldLineNumbers": [], "variants": [{"reconstruction": "%n šubat (|) arallê | uh[tarrir] | tâmtu", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "27'", "atf": "šu-bat a-ra-al-le-e uh-[tar-ri-ir x x]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "27'", "atf": "[x x a-ra-al]-le u[h-tar-ri-ir] tam*-ti₃\n#note: Collation @bib{RN250@195}.", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: (In) the Netherworld the seas were troubled,"}, {"number": "a+31", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ša apsî | šubat bēlūtēšu | (...) [uš]tādir", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "28'", "atf": "ša₂ ap-si-i šu-bat be-lu-te-[šu₂ x x x x]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "28'", "atf": "[x x x x šu]-bat be-[lu-te]-šu₂?# x [uš]-ta-dir", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: The residence of the lord of the Apsû (…) was terrified;"}, {"number": "a+32", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ša tâmti | iprid | ... | [nabnī]ssa", "manuscripts": [{"manuscriptId": 1, "labels": ["o"], "number": "29'", "atf": "ša₂ tam-ti₃ ip-rid x x [x x x x]\n$ end of side", "omittedWords": []}, {"manuscriptId": 2, "labels": ["o"], "number": "29'", "atf": "[x x x i]p?-ri-[id x x]-šu [nab-ni]t-sa\n$ end of side", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: The creatures of the sea … were filled with terror."}, {"number": "a+33", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [kīma zunni | u r]ādi | ibāʾūšunūti", "manuscripts": [{"manuscriptId": 1, "labels": ["r"], "number": "1", "atf": "[x x x r]a-di i-ba-ʾ#-[u₂-šu₂-nu-ti]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["r"], "number": "1", "atf": "[x x x ra-d]i [i]-b[a]-ʾa-u₂-š[u₂?-nu]-t[i?]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: [Like rain and] tempest they ravaged them,"}, {"number": "a+34", "oldLineNumbers": [], "variants": [{"reconstruction": "%n kīma mê | indahhū | arkīš[u]nu\n// cf. L I.10 SB \"III\" 34", "manuscripts": [{"manuscriptId": 1, "labels": ["r"], "number": "2", "atf": "GIM A-MEŠ in-da#-ah-hu a[r₂-ki-šu-nu]", "omittedWords": []}, {"manuscriptId": 2, "labels": ["r"], "number": "2", "atf": "[GIM A-MEŠ in-d]a-ah-<hu> [a]r₂-ki-š[u]-nu", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: Like water they drenched their wea
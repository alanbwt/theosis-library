f": "[...]-x#", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: […] …"}, {"number": "10'", "oldLineNumbers": [], "variants": [{"reconstruction": "[...] ...", "manuscripts": [{"manuscriptId": 1, "labels": ["i'"], "number": "10'", "atf": "[...]-ši", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: […] …"}, {"number": "11'", "oldLineNumbers": [], "variants": [{"reconstruction": "[...] ...", "manuscripts": [{"manuscriptId": 1, "labels": ["i'"], "number": "11'", "atf": "[...] x-aš-šu#", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: […] …"}, {"number": "12'", "oldLineNumbers": [], "variants": [{"reconstruction": "[...] ...", "manuscripts": [{"manuscriptId": 1, "labels": ["i'"], "number": "12'", "atf": "[...]-il", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: […] …"}, {"number": "13'", "oldLineNumbers": [], "variants": [{"reconstruction": "[...] ...", "manuscripts": [{"manuscriptId": 1, "labels": ["i'"], "number": "13'", "atf": "[...] x x", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: […] …"}, {"number": "14'", "oldLineNumbers": [], "variants": [{"reconstruction": "[...] ...", "manuscripts": [{"manuscriptId": 1, "labels": ["i'"], "number": "14'", "atf": "[...]-lu?#", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: […] …"}, {"number": "15'", "oldLineNumbers": [], "variants": [{"reconstruction": "[...] ...", "manuscripts": [{"manuscriptId": 1, "labels": ["i'"], "number": "15'-19'", "atf": "[...] x", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: […] …"}, {"number": "a+1'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n en[kīdu | lām (|) tallikam | ina šadîka]\n// L I.4 MB \"Priv₁\" 4\n// L I.4 SB \"I\" 241", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "1'", "atf": "{d}+e[n-ki-du₁₀ la-am ta-al-li-ka i-na ša-di-ka]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": true, "translation": "#tr.en: “O [Enkidu, even before you came from your uplands,]"}, {"number": "a+2'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n u[llîš | gilgāmeš | ina libbi (|) uruk || idaggal | šunātim]\n// L I.4 MB \"Priv₁\" 5\n// cf. L I.4 SB \"I\" 242", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "2'", "atf": "u[l-li-iš {d}GIŠ.GILₓ(BIL₂)-ga-mes i-na ŠA₃ UNUG{ki} i-da-ga-al šu-na-tim]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: yonder [in Uruk Gilgamesh was dreaming (of you).]"}, {"number": "a+3'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n it[tīlam-ma | gilgāmeš || ītamar | šuttam]\n// cf. L I.4 OB \"II\" 24\n// L I.4 MB \"Priv₁\" 6\n// L I.4 SB \"I\" 271", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "3'", "atf": "it-<<be₂#>>-[ti-la-am-ma {d}GIŠ.GILₓ(BIL₂)-ga-mes i-ta-mar šu-ut-ta]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: [Gilgamesh] lay(!) [down and had a dream,]"}, {"number": "a+4'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n itbe | īta[wwâ | ana ummīšu]\n// L I.4 OB \"II\" 25\n// L I.4 MB \"Priv₁\" 7\n// cf. L I.4 SB \"I\" 243", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "4'", "atf": "it-be₂ i-ta-[wa-a a-na um-mi-šu]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: he arose to [talk to his mother:]"}, {"number": "a+5'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ibbīšū-ma | [kakkabū (|) šamāʾī]\n// L I.4 OB \"II\" 6\n// L I.4 MB \"Priv₁\" 8\n// cf. L I.4 SB \"I\" 245", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "5'", "atf": "i-bi-šu-u₂-ma [ka-ak-ka-bu ša-ma-i]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: ‘[The stars of the sky] parted company,"}, {"number": "a+6'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n kiṣrum | ša ānim || [imqutam | ana ṣērīya]\n// L I.4 OB \"II\" 7\n// L I.4 MB \"Priv₁\" 9\n// cf. L I.4 SB \"I\" 246", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "6'", "atf": "ki-iṣ-rum ša# an-ni [im-qu₂-tam a-na ṣe-ri-ia]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: a lump of sky-rock [fell down before me.]"}, {"number": "a+7'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n altukšū-ma | [kabit? | elīya]\n// cf. L I.4 OB \"II\" 8\n// L I.4 MB \"Priv₁\" 10\n// cf. L I.4 SB \"I\" 247", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "7'", "atf": "al-tu-uk#-šu-u₂-ma# [ka-bi-it e-li-ia]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: I tested its (weight) but [it was too heavy for me,]"}, {"number": "a+8'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n askipšū-ma | nu[ššašu | ul elʾe]\n// cf. L I.4 OB \"II\" 9\n// L I.4 MB \"Priv₁\" 11\n// cf. L I.4 SB \"I\" 248", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "8'", "atf": "as-ki-ip-šu-u₂-ma nu-[uš-ša-šu u₂-ul el-e]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: I gave it a shove but [could not move it.]"}, {"number": "a+9'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n uruk | mādum || pahi[r | elīšu?]\n// cf. L I.4 OB \"II\" 10\n// L I.4 MB \"Priv₁\" 12\n// cf. L I.4 SB \"I\" 249", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "9'", "atf": "UNUG#{ki} ma-du-um pa-hi#-[ir e-li-šu?]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: Numerous Uruk was gathered [about me (@i{or} it),]"}, {"number": "a+10'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n pahrū | eṭlūtum || ul il[eʾʾū | šuqqâšu]\n// L I.4 MB \"Priv₁\" 13", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "10'", "atf": "pa-ah#-ru eṭ-lu-tum la i-l[e-u₂ šu-uq-qa₂-šu]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: the young men all together could not [raise it.]"}, {"number": "a+11'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ummid | pūtī || ī[midū | yâti]\n// L I.4 OB \"II\" 12-13\n// L I.4 MB \"Priv₁\" 14", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "11'", "atf": "u₂#-um-mi-id pu-ti i#-mi#-du# [ia-ti]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: I braced my forehead, they [supported me,]"}, {"number": "a+12'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n aššiaššū-ma | atbaššu | [ana mahrīki]\n// L I.4 OB \"II\" 14\n// L I.4 MB \"Priv₁\" 15\n// L I.4 SB \"I\" 255", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "12'", "atf": "aš-ši#-a-aš-šu-u₂-ma at-ba-šu# [a-na ma-ah-ri-ki]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: I picked it up and took it away [into your presence.]’"}, {"number": "a+13'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ummi (|) gilgāmeš || mū[deat | ipaššar?]\n#note: The end is restored with Priv₁. Another possible restoration is @i{kalāma}, with OB II.\n// L I.4 MB \"Priv₁\" 16\n// cf. L I.4 OB \"II\" 15", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "13'", "atf": "um#-mi {d}GIŠ.GILₓ(BIL₂)-ga-mes mu-[de-a-at x x x x]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: The mother of Gilgamesh, being [wise, explained (@i{or} wise in all things),]"}, {"number": "a+14'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n issaqqara | ana [gilgāmeš]\n// L I.4 MB \"Priv₁\" 17\n// L I.4 OB \"II\" 16", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "14'", "atf": "is#-sa₃-qa₂-ra-am & a-na# [{d}GIŠ.GILₓ(BIL₂)-ga-mes]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: saying to [Gilgamesh:]"}, {"number": "a+15'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n mā minde | gilgāmeš | ša [kīma kâtī-ma]\n// L I.4 MB \"Priv₁\" 18\n// L I.4 OB \"II\" 17", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "15'", "atf": "ma# mi-in-de {d}GIŠ.GILₓ(BIL₂)-ga-mes ša# [x x x x x]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: so: ‘For sure, Gilgamesh, there is one [like yourself,]"}, {"number": "a+16'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n im-mātim | walid-ma || urab[ba | ṣērum?]\n#note: The end is restored with Priv₁. Another possible restoration is @i{urabbīšu šadû}, with OB II.\n// cf. L I.4 MB \"Priv₁\" 19\n// cf. L I.4 OB \"II\" 18-19", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "16'", "atf": "im-ma-tim wa-li-id-ma u₂-ra#-ab#-[ba x x]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: he was born in the land and [the wild (@i{or} uplands)] reared [him.]"}, {"number": "a+17'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n kīma kiṣrim | ša ānim || dunnun[ā | emūqāšu]\n// L I.4 MB \"Priv₁\" 20", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "17'", "atf": "ki-ma ki-iṣ-ri-im ša an-ni du-un-nu-n[a x x x x]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: [His strength is] as mighty as a lump of sky-rock,"}, {"number": "a+18'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n aššum (|) uštamahharu | ittī[ka]\n// L I.4 MB \"Priv₁\" 21\n// L I.4 OB \"II\" 43", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "18'", "atf": "aš-šum uš-ta-ma-ah-ha-ru it-ti-[ka]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: so that I shall make him [your] equal."}, {"number": "a+19'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ul īdûšū-ma | ipahhurū | [elīšu]\n// L I.4 MB \"Priv₁\" 22", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "19'", "atf": "u₂-ul i-du-šu-u₂-ma i-pa-ah-hu-ru [x x x]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: Not knowing who he is, they will gather [around him,]"}, {"number": "a+20'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n eṭlūtum | unaššaqūnim | šâ[tu]\n// L I.4 MB \"Priv₁\" 23\n// cf. L I.4 OB \"II\" 21", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "20'", "atf": "eṭ-lu-tum u₂-na#-aš#-ša#-qu₂-nim ša-a-[tu]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: him the young men will kiss."}, {"number": "a+21'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n tammaršū-ma | libbaka | irī[aš]\n// cf. L I.4 MB \"Priv₁\" 24\n// cf. L I.4 OB \"II\" 20", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "21'", "atf": "ta#-am#-mar!-šu-u₂-ma li-ib-ba-ka i-ri-[a-aš]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: You will see him and your heart will rejoice,"}, {"number": "a+22'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [ted]diraššū-ma | taraddī[šu | ana mahrīya]\n// L I.4 MB \"Priv₁\" 25\n// L I.4 OB \"II\" 22-23", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "22'", "atf": "[te-ed]-di#-ra-aš-šu-u₂-ma ta-ra-ad-di-[šu x x x x x]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: [you will] hug him and lead [him into my presence.]’"}, {"number": "a+23'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [ittīlam]-ma | gilgāmeš ītam[ar | šuttam]\n// L I.4 MB \"Priv₁\" 31\n// cf. L I.4 OB \"II\" 24", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "23'", "atf": "[it-ti-la-am]-ma# {d}GIŠ.GILₓ(BIL₂)-ga-mes i-ta-m[ar x x x]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: Gilgamesh [lay down] and had [a dream (@i{or} another),]"}, {"number": "a+24'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [itbe | ītawwâ] | ana umm[īšu]\n// L I.4 MB \"Priv₁\" 32\n// L I.4 OB \"II\" 25", "manuscripts": [{"manuscriptId": 1, "labels": ["ii'"], "number": "24'", "atf": "[it-be₂ i-ta-wa-a] a#-na# um#-mi-[šu]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: [he arose to talk] to [his] mother.”"}], "record": {"authors": [{"name": "George", "prefix": "Andrew R.", "role": "EDITOR", "orcidNumber": "0000-0001-8231-190X"}, {"name": "Rozzi", "prefix": "Geraldina", "role": "REVISION", "orcidNumber": "0000-0002-1072-2512"}, {"name": "Jiménez", "prefix": "Enrique", "role": "REVISION", "orcidNumber": "0000-0003-0093-528X"}], "translators": [{"name": "George", "prefix": "Andrew R.", "orcidNumber": "0000-0001-8231-190X", "language": "en"}], "publicationDate": "2022-10-13T17:58:21.357308"}, "parserVersion": "6.1.0", "isFilteredQuery": false, "colophonLinesInQuery": {}}
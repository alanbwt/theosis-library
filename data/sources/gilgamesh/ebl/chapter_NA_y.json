{"textId": {"genre": "L", "category": 1, "index": 4}, "classification": "Ancient", "stage": "Neo-Assyrian", "version": "", "name": "y", "order": 91, "manuscripts": [{"id": 1, "siglumDisambiguator": "1a", "oldSigla": [], "museumNumber": "VAT.10585.B", "accession": "", "periodModifier": "Early", "period": "Neo-Assyrian", "provenance": "Aššur", "type": "Library", "notes": "", "colophon": "", "unplacedLines": "", "references": [{"id": "RN1007", "type": "EDITION", "pages": "11-32", "notes": "", "linesCited": [], "document": {"id": "RN1007", "author": [{"given": "Stefan M.", "family": "Maul"}], "title": "Reste einer frühneuassyrischen Fassung des Gilgamesch-Epos aus Assur", "container-title": "MDOG", "page": "11-32", "type": "article-journal", "citation-label": "RN1007", "issued": {"date-parts": [[2001]]}, "volume": "133"}}, {"id": "RN117", "type": "EDITION", "pages": "353-361", "notes": "", "linesCited": [], "document": {"id": "RN117", "author": [{"family": "George", "given": "Andrew R."}], "title": "The Babylonian Gilgamesh Epic. Introduction, Critical Edition and Cuneiform Texts", "publisher": "Oxford University Press", "publisher-place": "Oxford", "container-title-short": "BGE", "type": "book", "citation-label": "RN117", "issued": {"date-parts": [[2003]]}}}, {"id": "RN117", "type": "COPY", "pages": "pl. 31", "notes": "", "linesCited": [], "document": {"id": "RN117", "author": [{"family": "George", "given": "Andrew R."}], "title": "The Babylonian Gilgamesh Epic. Introduction, Critical Edition and Cuneiform Texts", "publisher": "Oxford University Press", "publisher-place": "Oxford", "container-title-short": "BGE", "type": "book", "citation-label": "RN117", "issued": {"date-parts": [[2003]]}}}, {"id": "RN1007", "type": "PHOTO", "pages": "17", "notes": "", "linesCited": [], "document": {"id": "RN1007", "author": [{"given": "Stefan M.", "family": "Maul"}], "title": "Reste einer frühneuassyrischen Fassung des Gilgamesch-Epos aus Assur", "container-title": "MDOG", "page": "11-32", "type": "article-journal", "citation-label": "RN1007", "issued": {"date-parts": [[2001]]}, "volume": "133"}}, {"id": "RN1007", "type": "COPY", "pages": "17", "notes": "", "linesCited": [], "document": {"id": "RN1007", "author": [{"given": "Stefan M.", "family": "Maul"}], "title": "Reste einer frühneuassyrischen Fassung des Gilgamesch-Epos aus Assur", "container-title": "MDOG", "page": "11-32", "type": "article-journal", "citation-label": "RN1007", "issued": {"date-parts": [[2001]]}, "volume": "133"}}], "joins": [], "isInFragmentarium": false}, {"id": 2, "siglumDisambiguator": "1b", "oldSigla": [], "museumNumber": "VAT.10916", "accession": "", "periodModifier": "Early", "period": "Neo-Assyrian", "provenance": "Aššur", "type": "Library", "notes": "", "colophon": "", "unplacedLines": "", "references": [{"id": "RN1007", "type": "EDITION", "pages": "11-32", "notes": "", "linesCited": [], "document": {"id": "RN1007", "author": [{"given": "Stefan M.", "family": "Maul"}], "title": "Reste einer frühneuassyrischen Fassung des Gilgamesch-Epos aus Assur", "container-title": "MDOG", "page": "11-32", "type": "article-journal", "citation-label": "RN1007", "issued": {"date-parts": [[2001]]}, "volume": "133"}}, {"id": "RN1007", "type": "PHOTO", "pages": "20, 23", "notes": "", "linesCited": [], "document": {"id": "RN1007", "author": [{"given": "Stefan M.", "family": "Maul"}], "title": "Reste einer frühneuassyrischen Fassung des Gilgamesch-Epos aus Assur", "container-title": "MDOG", "page": "11-32", "type": "article-journal", "citation-label": "RN1007", "issued": {"date-parts": [[2001]]}, "volume": "133"}}, {"id": "RN1007", "type": "COPY", "pages": "21, 24", "notes": "", "linesCited": [], "document": {"id": "RN1007", "author": [{"given": "Stefan M.", "family": "Maul"}], "title": "Reste einer frühneuassyrischen Fassung des Gilgamesch-Epos aus Assur", "container-title": "MDOG", "page": "11-32", "type": "article-journal", "citation-label": "RN1007", "issued": {"date-parts": [[2001]]}, "volume": "133"}}, {"id": "RN117", "type": "COPY", "pages": "pl. 31", "notes": "", "linesCited": [], "document": {"id": "RN117", "author": [{"family": "George", "given": "Andrew R."}], "title": "The Babylonian Gilgamesh Epic. Introduction, Critical Edition and Cuneiform Texts", "publisher": "Oxford University Press", "publisher-place": "Oxford", "container-title-short": "BGE", "type": "book", "citation-label": "RN117", "issued": {"date-parts": [[2003]]}}}, {"id": "RN117", "type": "EDITION", "pages": "353-361", "notes": "", "linesCited": [], "document": {"id": "RN117", "author": [{"family": "George", "given": "Andrew R."}], "title": "The Babylonian Gilgamesh Epic. Introduction, Critical Edition and Cuneiform Texts", "publisher": "Oxford University Press", "publisher-place": "Oxford", "container-title-short": "BGE", "type": "book", "citation-label": "RN117", "issued": {"date-parts": [[2003]]}}}], "joins": [], "isInFragmentarium": false}], "uncertainFragments": [], "lines": [{"number": "1'a", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [ilū-ma | itti šamaš || dāri]š | ušbū\n// L I.4 OB \"III\" 141", "manuscripts": [{"manuscriptId": 1, "labels": [], "number": "1'a", "atf": "%n [ilū-ma itti šamaš %sb da-ri-i]š uš#-bu# :\n$ line continues", "omittedWords": []}], "intertext": "Assyrian MS y comprises two fragments of similar clay and script, VAT 10585b and VAT 10916, that were identified by Stefan M. Maul in 2000 (@bib{RN1007}). They yield text of the episode in which the preparations for the journey to the Cedar Forest are described and accordingly can be compared with the Old Babylonian Yale tablet (OB Tablet III) and the Standard Babylonian epic (SB Tablets II–III). The first piece, MS y₁, is a small fragment that has only one face preserved. In it Gilgameš states his intention of doing battle with Ḫumbaba in the Cedar Forest, even if it means a glorious death (1′–5′). He chides the cautious Enkidu for the feeble objections that are ill suited to his fearsome appearance and heroic past (6′–9′). The obverse of the second piece, MS y₂, holds the remains of three speeches delivered at the meeting of the assembly of Uruk. Gilgameš tells of his plan to go to the Cedar Forest to make a name for himself (1′–5′). The counsellors advise that their king’s youthful enthusiasm has got the better of his judgement (6′–10′). They go on to warn him that the forest and its precious timber are guarded by the ogre Ḫumbaba, whom Enlil himself appointed (11′–15′). Gilgameš laughs off the elders’ warnings and reaffirms his intention of subduing Ḫumbaba (16′–19′). That done he plans to make rafts of logs from the Cedar Forest and float the timber down river to Babylonia, with Ḫumbaba’s decapitated head as the trophy of his victory (20′–2′). The counsellors respond in turn but here the text breaks off. This second speech must be their blessing for the journey, for that is what comes next in the older and younger versions of the epic (OB III 211–15, SB III 1–12) (adapted from @bib{RN117@353–361})."}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: ‘[Only the gods] have dwelled for [ever in the sunlight.]"}, {"number": "1'b", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ša amīlūte | m[anû | ūmūša]\n// L I.4 OB \"III\" 142\n// L I.4 SB \"II\" 234", "manuscripts": [{"manuscriptId": 1, "labels": [], "number": "1'b", "atf": "ša a-mi-lu-te m[a-nu-u₂ %n ūmūša]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: As for mankind, [its days] are [numbered,]"}, {"number": "2'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [...] ... | ṣulūla | ṣa[lmāt? | qaqqidi?]\n#note: See @bib{RN117@360}: “Though incomplete, the line is clearly very different from its counterpart in the Yale tablet and the late text. The verb @i{ṣullulā}, literally ‘they are in shade’, alludes to the shadow of death that looms over men.”", "manuscripts": [{"manuscriptId": 1, "labels": [], "number": "2'", "atf": "[...]-šu?# ṣu-lu-la ṣ[a]-a[l?-mat? %n qaqqidi?]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: […] …, @i{the human} [@i{race}] @i{is under a shadow}."}, {"number": "3'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [...] ... | lullika | ina pān[īka]\n#note: See @bib{RN117@360}: “The ventive verb is an exception to the rule that @i{alāku} and ventive means ‘come’, demonstrated for Gilgameš by @bib{hirsch1997heimkehr}.”\n// L I.4 OB \"III\" 146", "manuscripts": [{"manuscriptId": 1, "labels": [], "number": "3'", "atf": "[...] x lu-ul-li-ka i+na pa-n[i-i-ka]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: […] … I will walk in front [of you,]"}, {"number": "4'a", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [pīka | lilsâ || ṭihe | ē tādu]r\n// L I.4 OB \"III\" 147", "manuscripts": [{"manuscriptId": 1, "labels": [], "number": "4'a", "atf": "%n [pīka lilsâ ṭihe %sb e ta-du-u]r :\n$ line continues", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: [you can call to me, “Go to, do not] fear!”"}, {"number": "4'b", "oldLineNumbers": [], "variants": [{"reconstruction": "%n šumma! | amdaqut || šuma | l[ū ušzīz]\n#note: See @bib{RN117@360}: “The first word is corrupt; the Yale tablet reads @i{šumma amtaqut}.”\n// L I.4 OB \"III\" 148", "manuscripts": [{"manuscriptId": 1, "labels": [], "number": "4'b", "atf": "<šu>-um-ma am-da-qu-ut šu-ma l[u %n ušzīz]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: If(!) I fall, I should [have made] a name:"}, {"number": "5'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [gilgāmeš | itti] hubbebe | dapīni || tuqumta | išk[un (...)]\n#note: See @bib{RN117@360}: “The verb of the Yale tablet is @i{ištu}. This version of the poem uses a more neutral word.”\n// L I.4 OB \"III\" 149-150", "manuscripts": [{"manuscriptId": 1, "labels": [], "number": "5'", "atf": "[{m}{d}GIŠ-TUK %n itti] %sb {m#}hu-be-be da-pi-ni GIŠ.LA₂ iš-k[un (x x)]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: (men will say) “[Gilgameš] did battle [with] ferocious Ḫumbaba!”"}, {"number": "6'a", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [... | qar]radūtu?\n// cf. L I.4 OB \"III\" 145", "manuscripts": [{"manuscriptId": 1, "labels": [], "number": "6'a", "atf": "[x x x x x x qar?]-ra-du-tu :\n$ line continues", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: […] @i{warriorhood},"}, {"number": "6'b", "oldLineNumbers": [], "variants": [{"reconstruction": "%n eṭlūtu | ihbut[ū | maharka]\n// L I.4 OB \"III\" 153\n// L I.4 SB \"II\" 239", "manuscripts": [{"manuscriptId": 1, "labels": [], "number": "6'b", "atf": "eṭ-lu-tu ih-bu-t[u %n maharka]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: warriors fled [from your presence.]"}, {"number": "7'a", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [...] ...\n// cf. L I.4 OB \"III\" 154-155\n// cf. L I.4 SB \"II\" 231", "manuscripts": [{"manuscriptId": 1, "labels": [], "number": "7'a", "atf": "[x x x x x x x] x-ti₃ :\n$ line continues", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: […] …,"}, {"number": "7'b", "oldLineNumbers": [], "variants": [{"reconstruction": "%n u attā | enkīdi || ak[ī pasniqi | taqabbi]\n// L I.4 OB \"III\" 156\n// L I.4 SB \"II\" 232", "manuscripts": [{"manuscriptId": 1, "labels": [], "number": "7'b", "atf": "u at-ta {m}en-ki-di a-k[i-i %n pasniqi taqabbi]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: but (now), Enkidu, [you speak] like [a weakling!]"}, {"number": "8'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [išhiṭkā-ma | labbu] || kalāma | tī[de | ...]\n#note: See @bib{RN117@360}: “As restored from its counterparts, this line of tablet is not filled and may have held two lines of poetry. The spelling @i{ti-id-}[@i{de}] for @i{tīde} exhibits the principal that long syllables can be written closed (see the introduction, spelling point o). Maul proposes a different solution, in which @i{tidde} exhibits the influence of the MA and NA present @i{udda}.”\n// L I.4 OB \"III\" 152\n// L I.4 SB \"II\" 238", "manuscripts": [{"manuscriptId": 1, "labels": [], "number": "8'", "atf": "%n [išhiṭkā-ma %sb lab-bu] ka#-la-ma ti-id-[de ...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: [A lion took fright of you and] you experienced all! [(…)]"}, {"number": "9'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [pīka | irmâm-ma || tul]emm[in | libbī]\n// L I.4 OB \"III\" 157\n// L I.4 SB \"II\" 233", "manuscripts": [{"manuscriptId": 1, "labels": [], "number": "9'", "atf": "%n [pīka irmâm-ma %sb tu-l]e-em#-m[i-in %n libbī]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: [With your feeble talk you have] vexed [my heart.]’"}, {"number": "a+1'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [...] ... [...]\n#note: See @bib{RN117@360}: “Maul reads the traces as @akk{in?-na?-ṣ[i?-ir?}. Without good context it is better to reserve judgement.”", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "1'", "atf": "[...] x x x [...]", "omittedWords": []}], "intertext": "MS y₂ obv. (col. ii′)"}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: […] … […]"}, {"number": "a+2'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [...] ... [...]", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "2'", "atf": "[x x x x x x tu]r?-ra-šu x [...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: ‘[…] his … […]"}, {"number": "a+3'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [kīma dannu | ilitt]u | ša uruk || l[ušešmi | māta]\n#note: See @bib{RN117@360}: “The traces exclude the Yale tablet’s @i{perḫum ša Uruk}.”\n// L I.4 OB \"III\" 185-186", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "3'", "atf": "%n [kīma dannu %sb i-lit-t]u ša UNUG{ki#} l[u-še-eš-mi %n māta]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: [that] Uruk’s progeny [is mighty] I will [have the land learn.]"}, {"number": "a+4'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [qātī | luš]kun || laksi[ma? | erēna?]\n// L I.4 OB \"III\" 187", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "4'", "atf": "%n [qātī %sb lu-uš]-kun la-ak!?#-si-[ma %n erēna?]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: [Let me] start [work,] I will @i{chop} [@i{down the cedar},]"}, {"number": "a+5'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [...] ... [...]\n#note: See @bib{RN117@360}: “Perhaps @akk{GIŠ-MEŠ} (Maul).”", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "5'", "atf": "[x x x x x] x x x-MEŠ x x x [...]\n$ single ruling", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: […] … […]’"}, {"number": "a+6'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [itbû-ma | mālik]ū | rabûtu\n// L I.4 SB \"II\" 287", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "6'", "atf": "%n [itbû-ma %sb ma-li-k]u GAL-MEŠ :", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: The senior [advisers rose,]"}, {"number": "a+6'b", "oldLineNumbers": [], "variants": [{"reconstruction": "%n izzaqqurū | [ana gilgāmeš]\n// L I.4 SB \"II\" 287", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "6'b", "atf": "iz-za-qu-ru [ana {m}{d}GIŠ-TUK]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: saying [to Gilgameš:]"}, {"number": "a+7'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [ṣehrēta] | bēlī | libbaka | [našīka]\n// L I.4 OB \"III\" 191\n// L I.4 SB \"II\" 289", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "7'", "atf": "%n [ṣehrēta] %sb EN lib₃-ba-ka %n [našīka]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: ‘[You are young,] my lord, [carried away] by enthusiasm,"}, {"number": "a+8'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [...] | ša taqabbû | magir | [...]\n#note: See @bib{RN117@360}: “8' // 10'. A negative is required to save the sense of the line, for the elders are clearly opposed to Gilgameš’s wish.”\n// L I.4 OB \"III\" 192\n// L I.4 SB \"II\" 290", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "8'", "atf": "[...] ša ta-qab-bu-u₂ ma-gir [...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: […] what you speak of finds [no] favour […]"}, {"number": "a+9'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [ṣehrēt]a | bēlī | [li]bbaka | [našīka]\n#note: See @bib{RN117@360}: “The traces of @i{libbaka} are collated.”", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "9'", "atf": "[ṣe-eh-re-t]a EN [li]b₃-ba#-ka %n [našīka]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: ‘You [are young,] my lord, [carried away] by enthusiasm,"}, {"number": "a+10'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [...] | ša taqabbû | magi[r | ...]", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "10'", "atf": "[...] ša ta#-qab#-bu-u₂ ma-gi[r ...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: […] what you speak of finds [no] favour […]"}, {"number": "a+11'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [...] ... hubbebe | dapīnu | elī[ka? | ...]", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "11'", "atf": "[x x x x] x x {m#}hu?#-be?#-be da-pi-nu UGU-[ka? ...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: […] … of Ḫumbaba will be too ferocious for [@i{you} …,]"}, {"number": "a+12'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [pīš]u | girru || siqirš[u | mūtu?]\n// L I.4 OB \"III\" 198\n// L I.4 SB \"II\" 292", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "12'", "atf": "[pi-i-š]u {d}gira₃ si-qir-š[u %n mūtu?]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: his [speech] is fire, his utterance [is @i{death}.]"}, {"number": "a+13'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [ana š]ūši (|) bēri || lamâssu | [qištu]\n#note: See @bib{RN117@360}: “The signs @i{be-ri} replace the status absolutus @i{bēr} of the Old Babylonian text (note also @i{bé-ru} in MB Boǧ₁ d 7'). As the replacement of the older version’s difficult @i{nu-ma-at}, the word @i{la-ma-su} is probably an intentional emendation by a baffled editor, with @i{nu} interpreted as @i{là}.”\n// L I.4 OB \"III\" 195\n// L I.4 SB \"II\" 293", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "13'", "atf": "[ana 1.GI]Š₃-TA#.AM₃# be-ri la-ma-su %n [qištu]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: [For] sixty leagues each way, [the forest] surrounds him,"}, {"number": "a+14'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [mann]u | ša urrudu | ana libbi\n// L I.4 OB \"III\" 196\n// L I.4 SB \"II\" 295", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "14'", "atf": "[ma-an-n]u ša u₂-ru-du ana lib₃-bi :", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: [who] is there would venture within?"}, {"number": "a+14'b", "oldLineNumbers": [], "variants": [{"reconstruction": "%n addu | ilt[ēn || šū | šanû]\n// L I.4 OB \"III\" 134-135\n// L I.4 SB \"II\" 297", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "14'b", "atf": "{d}ad-du il-t[e-en %n šū šanû]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: Adad is the [first, (but) he is the second!]"}, {"number": "a+15'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [aššu š]ullume (|) erēnīšu\n// L I.4 OB \"III\" 136\n// L I.4 SB \"II\" 298", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "15'", "atf": "%n [aššu %sb š]ul-lu-me e-re-ni-šu :", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: [In order to] keep his cedars safe,"}, {"number": "a+15'b", "oldLineNumbers": [], "variants": [{"reconstruction": "%n pulhête | ša ni[šī || išīmšu | ellil]\n#note: See @bib{RN117@360}: “This line stands midway between the Yale tablet (OB III 136–7: @i{aššum šullum}[@i{u erēnim}] / @i{pulḫiʾātim} (@akk{pu-ul-hi-a-tim}) @i{sebe iš}[@i{īmšum Ellil}]) and the late version (SB II 218–19a, etc.: @i{aššu šullumu erēni} / @i{ana pulḫāti ša nišī išīmšu Ellil}). Unless one emends the present text to <@i{ana}> @i{ pulḫete} with SB II, the word spelled @i{pu-ul-ḫe-te} is accusative and consequently plural, as in the Yale tablet. Assyrrian vowel harmony is then ruled out as an explanation for the vowel /e/ after the stem (< *@i{pulḫate}). Instead the form represents an unusual contraction of the Yale tablet’s broken plural, @i{pulḫiʾātim} > @i{pulḫête} (for the contraction /ia/ to /ê/ outside Mari see @i{GAG}³ §16k).”\n// L I.4 OB \"III\" 137\n// cf. L I.4 OB \"Schøyen₃\" b+4'\n// L I.4 SB \"II\" 299", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "15'b", "atf": "pu-ul-he-te ša UN-[MEŠ %n išīmšu ellil]\n$ single ruling", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: [Enlil made it his destiny] (to be) the terror of the people.’"}, {"number": "a+16'a", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [gi]lgāmeš | annīta | ina šamêšu\n// cf. L I.4 OB \"III\" 201\n// L I.4 SB \"II\" 300", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "16'a", "atf": "[{m}{d}GI]Š-TUK an-ni-ta ina ša-me-e-šu :\n$ line continues", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: When Gilgameš heard this,"}, {"number": "a+16'b", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ussahhir | pānīšu | ana i[brīšu]\n#note: See @bib{RN117@361}: “For the expression @i{pānī suḫḫuru}, literally ‘to turn back the face’, see @i{CAD} S, s.v. @i{saḫāru} 11.a.2. At the break Maul reads @i{ta}[@i{p-pe-e-šu}?].”", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "16'b", "atf": "us-sa₃-hi-ir IGI-šu a-na i[b!-ri-šu]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: he turned around to [his] friend."}, {"number": "a+17'a", "oldLineNumbers": [], "variants": [{"reconstruction": "%n i[ṣ]īh | izzaqqara | ana enkīdi\n// L I.4 OB \"III\" 202\n// L I.4 SB \"II\" 301", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "17'a", "atf": "i#-[ṣ]i-ih i-za-qa-ra a-na {m}en-ki#-di :\n$ line continues", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: He laughed, saying to Enkidu:"}, {"number": "a+17'b", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ibrī | kâmma | ... [...]\n#note: See @bib{RN117@361}: “Maul considers @i{e-}[@i{du-ru pānūšunu}], ‘wie sehr ver[finsterte sich doch ihr Gesicht!]’”\n// L I.4 OB \"III\" 203", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "17'b", "atf": "ib-ri ka-ma e?-[...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: ‘My friend, shall I be so […,]"}, {"number": "a+18'a", "oldLineNumbers": [], "variants": [{"reconstruction": "%n apallah-mâ | ul allaka | ana mahrīšu\n// L I.4 OB \"III\" 204", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "18'a", "atf": "a-pa-la-ah-ma-a ul al-la-ka a-na mah-ri#-šu :\n$ line continues", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: so afraid that I cannot go into his presence?"}, {"number": "a+18'b", "oldLineNumbers": [], "variants": [{"reconstruction": "%n allak | [urha || rūqata | ašar (|) hubbebe?]", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "18'b", "atf": "al-la-ak %n [urha rūqata ašar hubbebe?]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: I shall travel [@i{the distant path to where Ḫumbaba is,}]"}, {"number": "a+19'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n u kīma labbe | hubbaba | ... [...]\n#note: See @bib{RN117@361}: “Maul reads @i{ú-p}[@i{a-a}]@i{q}?, commenting ‘falls sich die Lesung als korrekt erweist, liegt eine D-Stamm-Form des Verbs @i{epēqu}, “umfassen”, “bedecken” vor’. The meaning of @i{uppuqu} is by no means certain.”", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "19'", "atf": "u₃ ki-ma lab-be {m}hu-ba-ba u₂-x ak? ma ṣu x [...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: and Ḫumbaba, like a lion, I shall … […,]"}, {"number": "a+20'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n amāte | urakkasa || ša erēni (|) šurmēni (|) [u supāli?]\n#note: See @bib{RN117@361}: “20'–2'. Compare SB V “200–2” [321–324]: @i{irtaksū amu ittadû} […] / @i{Enkīdu rakib} […] (MS H differs) / @i{u Gilgāmeš qaqqad Ḫumbaba rakib-m}[@i{a} …]. In l. 20' the third wood is restored after a line in which Ḫuwawa tells Gilgameš the types of timber he can supply (OB Harmal₂ 46–7: [@i{l}]@i{urabbiʾakkum erēnam šurmēnam supālam šīḫūtim iṣṣī simatu ekallim}). In l. 21' Maul reads @akk{u₂-sa-nap#-sa-[ak]}, ‘werde ich (es) darauf fortschaffen lassen’, commenting that ‘das nur (neu)assyrisch belegte Verb @i{passuku}, “entfernen”, “wegräumen” ist hier erstmals im Š-Stamm (bzw. Štn-Stamm) belegt’. Fully Assyrian words are rare in the epic, even in the early NA sources, and while the decipherment is not secure it is wiser not to introduce into an essentially Babylonian text a very specialized Assyrian verb in a previously unattested stem.”", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "20'", "atf": "{giš}a-ma-a-te-MEŠ u₂-rak-ka#-sa# ša {giš}EREN {giš}ŠUR.MIN₃ %n [u supāli?]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: I shall rope together rafts of cedar, cypress [and @i{supālu-}juniper(?).]"}, {"number": "a+21'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ina libbi | usannaq? [...]", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "21'", "atf": "i+na lib₃-bi u₂-sa-naqₓ(|NAGA|) [...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: Thereon I shall @i{collect together} […,]"}, {"number": "a+22'", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [q]aqqad (|) hubbebe | anakkisa(m)-ma | aqqalappâ | [...]", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "22'", "atf": "[q]aq-qa-ad# {m}hu-be-be a-na-ki-sa-ma aq-qa-la#-pa-a# [...]\n$ single ruling", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: I shall cut off the head of Ḫumbaba and come downstream […]’"}, {"number": "a+23'a", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [...] ... | mālikū | ra[bû]tu\n#note: See @bib{RN117@361}: “Maul reads the opening word @akk{[ib]-ku-ma}, ‘[sie] weinten’.”", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "23'a", "atf": "[x] x-ma# ma-li-ku GA[L-ME]Š :\n$ line continues", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: The senior advisers …,"}, {"number": "a+23'b", "oldLineNumbers": [], "variants": [{"reconstruction": "%n izzaqqurū | [ana gilgāmeš]", "manuscripts": [{"manuscriptId": 2, "labels": ["o", "ii'"], "number": "23'b", "atf": "iz-zaq-qu-ru [ana {m}
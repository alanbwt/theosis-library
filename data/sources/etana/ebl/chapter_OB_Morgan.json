"book", "citation-label": "BRM_4", "issued": {"date-parts": [[1923]]}}}, {"id": "RN1538kkk", "type": "COPY", "pages": "pl. 12", "notes": "", "linesCited": [], "document": {"id": "RN1538kkk", "author": [{"family": "Langdon", "given": "Stephen Herbert"}], "title": "The Legend of Etana and The Eagle or the Epical Poem 'The city they hated'", "container-title": "Babyloniaca", "page": "1-56, pls. I-XIV", "type": "article-journal", "citation-label": "RN1538kkk", "issued": {"date-parts": [[1931]]}, "volume": "12"}}, {"id": "RN1189a", "type": "COPY", "pages": "pl. 1", "notes": "", "linesCited": [], "document": {"id": "RN1189a", "author": [{"family": "Kinnier Wilson", "given": "J.V."}], "title": "The Legend of Etana: A New Edition", "publisher-place": "Warminster", "type": "book", "citation-label": "RN1189a", "issued": {"date-parts": [[1985]]}}}, {"id": "RN2368a", "type": "COPY", "pages": "pl. 8", "notes": "", "linesCited": [], "document": {"id": "RN2368a", "author": [{"family": "Saporetti", "given": "C."}], "title": "Etana", "publisher": "Sellerio", "publisher-place": "Palermo", "type": "book", "citation-label": "RN2368a", "issued": {"date-parts": [[1990]]}}}, {"id": "YOSR_3_V", "type": "PHOTO", "pages": "pl. 7", "notes": "", "linesCited": [], "document": {"id": "YOSR_3_V", "author": [{"family": "Clay", "given": "Albert T."}], "title": "A Hebrew Deluge Story in Cuneiform, and Other Epic Fragments in the Pierpont Morgan Library", "publisher": "Yale University Press", "publisher-place": "New Haven", "collection-title": "Yale Oriental Series, Researches", "container-title-short": "YOSR", "collection-number": "V/3", "type": "book", "citation-label": "YOSR_3_V", "year-suffix": "_V", "issued": {"date-parts": [[1922]]}}}, {"id": "RN2067", "type": "DISCUSSION", "pages": "484-486", "notes": "", "linesCited": [], "document": {"id": "RN764", "author": [{"given": "Michael P.", "family": "Streck"}], "title": "Notes on the Old Babylonian Epics of Anzu and Etana", "container-title": "Journal of the American Oriental Society", "page": "477-486", "type": "article-journal", "citation-label": "RN764", "issued": {"date-parts": [[2009]]}, "volume": "129", "aliases": [{"value": "RN2067", "normalizedValue": "rn2067", "type": "legacy_id", "source": "duplicate_merge_2026-08-04", "status": "redirect"}]}}, {"id": "RN1553", "type": "PHOTO", "pages": "477", "notes": "obverse", "linesCited": [], "document": {"id": "RN1553", "author": [{"family": "Aruz", "given": "Joan"}], "title": "Art of the first cities : the third millennium B.C. from the Mediterranean to the Indus", "publisher": "Metropolitan Museum of Art ;\r\nYale University Press", "publisher-place": "New York\r\nNew Haven", "page": "xxiv, 540 p.", "ISBN": "1588390438 (hc.)\r\n1588390446 (pbk.)\r\n0300098839 (Yale)", "type": "book", "citation-label": "RN1553", "issued": {"date-parts": [[2003]]}}}], "joins": [], "isInFragmentarium": false}], "uncertainFragments": [], "lines": [{"number": "1", "oldLineNumbers": [], "variants": [{"reconstruction": "%n rabûtum | anunnakkū || šāʾimū (|) šīmtim\n// cf. L I.9 SB \"I\" 8", "manuscripts": [{"manuscriptId": 1, "labels": ["i"], "number": "1", "atf": "ra-bu-tum {d}a-nun-na ša-i-mu ši-im-tim", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: The great Anunna-gods, ordainers of destiny,"}, {"number": "2", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ušbū | imlikū || milikša | mātam\n#note: The possessive suffix -@i{ša} in @i{milikša} has been subject to debate, see @bib{RN764@484} in detail. Despite the reservations expressed there, it may refer to @i{mātum}, since the phrase @i{milik māti malāku} is attested elsewhere, e.g. @i{inūma} DN … @i{milik mātim imlikū} (@bib{RN896@E4.11.1.1}). The simplest interpretation would be to understand the line as a hendiadys: “they decided her decision (and) the country” i.e. “they decided the country’s decision”.\n// cf. L I.9 SB \"I\" 9", "manuscripts": [{"manuscriptId": 1, "labels": ["i"], "number": "2", "atf": "uš-bu im-li-ku mi-li-ik-ša ma-a-ta-°tam?\\am°", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: Sat taking counsel with respect to the land."}, {"number": "3", "oldLineNumbers": [], "variants": [{"reconstruction": "%n bānû (|) kibrātim || šākinū (|) šikittim\n// cf. L I.9 SB \"I\" 10", "manuscripts": [{"manuscriptId": 1, "labels": ["i"], "number": "3", "atf": "ba-nu ki-ib-ra-tim ša-ki-nu ši-ki-it-tim\n#note: Scheil’s (@bib{Scheil.RT23@19}) copy shows an extra @akk{u} following @akk{ba-nu}. Collation, however, shows that none is present.", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: Those creators of the world regions, establishers of all physical form,"}, {"number": "4", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ṣīrū | ana nišī || ilū | igīgū\n// cf. L I.9 SB \"I\" 11", "manuscripts": [{"manuscriptId": 1, "labels": ["i"], "number": "4", "atf": "ṣi-ru a-na ni-ši i-lu i-gi₄-gu", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: Those sublime for the people, the Igigi-gods,"}, {"number": "5", "oldLineNumbers": [], "variants": [{"reconstruction": "%n isinnam | ana nišī | išīmū\n// cf. L I.9 SB \"I\" 11", "manuscripts": [{"manuscriptId": 1, "labels": ["i"], "number": "5", "atf": "i-si₂-nam a-na ni-ši i-ši-mu", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: Ordained the @i{holy day} for the people."}, {"number": "6", "oldLineNumbers": [], "variants": [{"reconstruction": "%n šarram | lā iškunū || kalû nišī | epiātim\n// cf. L I.9 SB \"I\" 12", "manuscripts": [{"manuscriptId": 1, "labels": ["i"], "number": "6", "atf": "šar-ra-am la iš-ku-nu ka-lu ni-ši e-pi₂-a-tim", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: Among all the teeming peoples they had established no king,"}, {"number": "7", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ina šiātim | lā kaṣrat || kubšum | meānum\n#note: The understanding as @i{ina šiātim} is based on the Standard Babylonian version’s @i{ina ūmīšū-ma}. For other possibilities see @bib{RN764@484}, where a rendering as “in this (land)” = “here” is preferred, in reference to the land in l. 2.\n// cf. L I.9 SB \"I\" 13", "manuscripts": [{"manuscriptId": 1, "labels": ["i"], "number": "7", "atf": "i-na ši-a₃(PI)-tim la ka-aṣ@v-ra-at ku-ub-šum me-a-nu", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: Then no headdress had been put together, nor crown,"}, {"number": "8", "oldLineNumbers": [], "variants": [{"reconstruction": "%n u haṭṭum | uqniam | lā ṣaprat\n// cf. L I.9 SB \"I\" 14", "manuscripts": [{"manuscriptId": 1, "labels": ["i"], "number": "8", "atf": "u₃ ha-aṭ-ṭu₃-um uq@v-ni-a-am la ṣa-ap-ra-at", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: Nor yet scepter had been set with lapis,"}, {"number": "9", "oldLineNumbers": [], "variants": [{"reconstruction": "%n lā banû | ištēniš | parakkū\n// cf. L I.9 SB \"I\" 15", "manuscripts": [{"manuscriptId": 1, "labels": ["i"], "number": "9", "atf": "la ba-nu-u₂ iš-ti-ni-iš pa-ra-ak-ku", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: No throne daises at all had been constructed,"}, {"number": "10", "oldLineNumbers": [], "variants": [{"reconstruction": "%n sebetta | bābū || uddulū | eli dapnim\n#note: For a discussion of this line see @bib{lambert1980line} (“‘Seven gates were bolted on the hero,’ which means that potential kings had absolutely no chance to exercise kingship”). For a more detailed analysis of @i{sebetta}/@i{sebēta}, see @bib{RN764@484-485}.\n// cf. L I.9 SB \"I\" 16-17", "manuscripts": [{"manuscriptId": 1, "labels": ["i"], "number": "10", "atf": "se-be₂-ta ba-bu ud-du-lu e-lu da-ap-nim", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: Full seven gates were bolted against the hero."}, {"number": "11", "oldLineNumbers": [], "variants": [{"reconstruction": "%n haṭṭum | meānum || kubšum | u šibirrum", "manuscripts": [{"manuscriptId": 1, "labels": ["i"], "number": "11", "atf": "ha-aṭ-ṭu₃-um me-a-nu-um ku-ub-šum u₃ ši-bi-ir-ru", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: Scepter, crown, headdress, and staff"}, {"number": "12", "oldLineNumbers": [], "variants": [{"reconstruction": "%n qudmiš (|) ānim || ina šamāʾī | šaknū", "manuscripts": [{"manuscriptId": 1, "labels": ["i"], "number": "12", "atf": "qu₂-ud-mi-iš a-ni-im i-na ša-ma-i ša-ak-nu", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: Were set before Anu in heaven."}, {"number": "13", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ul ibašši | mitlukum | ana nišīša\n#note: According to @bib{RN764@484}, the possessive suffix -@i{ša} in @i{nišīša} would refer to the land in l. 2.", "manuscripts": [{"manuscriptId": 1, "labels": ["i"], "number": "13", "atf": "u₂-ul i-ba-aš-ši mi-it-lu-ku <a-na> ni-°\\ši°-ša\n#note: Or, alternatively, @akk{mi-it-lu-ku ša:ni:°x\\ši°}?", "omittedWords": [6]}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: There was no right counsel for @i{its} people:"}, {"number": "14", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [šar]rūtum | ina šamāʾī | urdam", "manuscripts": [{"manuscriptId": 1, "labels": ["i"], "number": "14", "atf": "[šar]-ru*#-tum# i-na ša-ma-i ur-da#-am\n#note: Scheil’s (@bib{Scheil.RT23@19}) copy shows @akk{[x]-ru-tum}. Although an alternative @akk{[be]-el-tum} was suggested by Wilcke and followed since then by most editors (see @bib{RN239@123-124}, also @bib{HaulrevSAACT2@570 ad I 27}), collation from the photograph confirms @akk{ru#} (see also @bib{RN764@485}).", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: (Then) did [kin]gship come down from heaven."}, {"number": "15", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [...] ... | šarr[am?] | īši", "manuscripts": [{"manuscriptId": 1, "labels": ["i"], "number": "15", "atf": "[...] (x) x i#-iš?#/ka?#-ri*# šar?#-r[a?-am?] i#-ši-i#", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: [...] ... had a @i{king},"}, {"number": "16", "oldLineNumbers": [], "variants": [{"reconstruction": "%n [...] ... [...]", "manuscripts": [{"manuscriptId": 1, "labels": ["i"], "number": "16", "atf": "[...] x [...]\n$ rest of column broken", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: [...] ... [...]"}, {"number": "a+1", "oldLineNumbers": [], "variants": [{"reconstruction": "%n leqē-[ma? ...]", "manuscripts": [{"manuscriptId": 1, "labels": ["ii"], "number": "1", "atf": "le-qe₂-e?#-[ma? ...]\n#note: Scheil’s (@bib{Scheil.RT23@19}) copy shows @akk{KU} but @akk{E} cannot be excluded either.", "omittedWords": []}], "intertext": "gap"}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: “@i{Take} [...],"}, {"number": "a+2", "oldLineNumbers": [], "variants": [{"reconstruction": "%n marhīs[su? | ...]\n// cf. L I.9 SB \"I\" a+2", "manuscripts": [{"manuscriptId": 1, "labels": ["ii"], "number": "2", "atf": "mar-hi-is-[su? ...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: “[@i{His}] wife [...],"}, {"number": "a+3", "oldLineNumbers": [], "variants": [{"reconstruction": "%n lā ihl[iq? | ...]", "manuscripts": [{"manuscriptId": 1, "labels": ["ii"], "number": "3", "atf": "la ih-l[i*-iq? ...]\n#note: For the third sign, @akk{BU} can be excluded, since the manuscript uses a more archaic form of the sign @akk{BU}.", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: “Lest [@i{his goods} ...] be lo[st].”"}, {"number": "a+4", "oldLineNumbers": [], "variants": [{"reconstruction": "%n būšu[m? | ...]", "manuscripts": [{"manuscriptId": 1, "labels": ["ii"], "number": "4", "atf": "bu-šu-[um? ...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: “@i{The goods} [...],"}, {"number": "a+5", "oldLineNumbers": [], "variants": [{"reconstruction": "%n u an[a ...]", "manuscripts": [{"manuscriptId": 1, "labels": ["ii"], "number": "5", "atf": "u₃ a-n[a ...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: “And fo[r ...]"}, {"number": "a+6", "oldLineNumbers": [], "variants": [{"reconstruction": "%n lūhu[z? | ...]", "manuscripts": [{"manuscriptId": 1, "labels": ["ii"], "number": "6", "atf": "lu-hu-[uz? ...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: “I will tak[e @i{a wife} ...]!”"}, {"number": "a+7", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ill[ik? | ...]", "manuscripts": [{"manuscriptId": 1, "labels": ["ii"], "number": "7", "atf": "il-l[i-ik? ...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: [@i{Off}] he we[nt ...],"}, {"number": "a+8", "oldLineNumbers": [], "variants": [{"reconstruction": "%n wašb[at? | ...]", "manuscripts": [{"manuscriptId": 1, "labels": ["ii"], "number": "8", "atf": "wa-aš-b[a*-at? ...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: [@i{She}] was liv[ing in ...],"}, {"number": "a+9", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ina [...]", "manuscripts": [{"manuscriptId": 1, "labels": ["ii"], "number": "9", "atf": "i-na [...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: In [...],"}, {"number": "a+10", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ina [...]", "manuscripts": [{"manuscriptId": 1, "labels": ["ii"], "number": "10", "atf": "i-na [...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: In [...],"}, {"number": "a+11", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ... [...]", "manuscripts": [{"manuscriptId": 1, "labels": ["ii"], "number": "11", "atf": "i-[...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: ... [...],"}, {"number": "a+12", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ilq[e? ...]", "manuscripts": [{"manuscriptId": 1, "labels": ["ii"], "number": "12", "atf": "il-q[e₂? ...]\n#note: Scheil’s (@bib{Scheil.RT23@19}) copy shows @akk{il-ki-[...]}.", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: He @i{to}[@i{ok} ...],"}, {"number": "a+13", "oldLineNumbers": [], "variants": [{"reconstruction": "%n u [...]", "manuscripts": [{"manuscriptId": 1, "labels": ["ii"], "number": "13", "atf": "u₃*# [...]\n#note: Scheil’s (@bib{Scheil.RT23@19}) copy shows @akk{u₃}.\n$ rest of column broken", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: And [...]."}, {"number": "b+1", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ... [...]", "manuscripts": [{"manuscriptId": 1, "labels": ["v"], "number": "1'", "atf": "lu-ta-[...]", "omittedWords": []}], "intertext": "gap"}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: @i{I will} ... [...]!"}, {"number": "b+2", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ... [...]", "manuscripts": [{"manuscriptId": 1, "labels": ["v"], "number": "2'", "atf": "da-ab-[...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: ... [...]"}, {"number": "b+3", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ṣēru | p[âšu | īpušam-ma | ana erîm-ma | izzakaršu]", "manuscripts": [{"manuscriptId": 1, "labels": ["v"], "number": "3'", "atf": "ṣe-ru p[a-a-šu x x x x x x x x x x x] | ($___$) [x x x x x]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: The serpent [made ready to speak, saying to the eagle],"}, {"number": "b+4", "oldLineNumbers": [], "variants": [{"reconstruction": "%n mā | uwa[ššarka? | ...]", "manuscripts": [{"manuscriptId": 1, "labels": ["v"], "number": "4'", "atf": "ma-a u₂-wa-a[š*-ša-ar-ka? ...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: “Were I [to set you free ...],"}, {"number": "b+5", "oldLineNumbers": [], "variants": [{"reconstruction": "%n šēretk[a | ...]", "manuscripts": [{"manuscriptId": 1, "labels": ["v"], "number": "5'", "atf": "ši-ri-it-k[a ...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: “Your punishment [will come upon me ...],"}, {"number": "b+6", "oldLineNumbers": [], "variants": [{"reconstruction": "%n utta? | ... [...]", "manuscripts": [{"manuscriptId": 1, "labels": ["v"], "number": "6'", "atf": "ut-ta ṣe-x [...]\n#note: Cf. @bib{RN764@485} (with earlier suggestions): @akk{ut-ta-ṣi}(-)[...] “He spread(?) [...].”.", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: “I @i{will find} ... [...]!”"}, {"number": "b+7", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ibqumšū-[ma? | ...]", "manuscripts": [{"manuscriptId": 1, "labels": ["v"], "number": "7'", "atf": "ib-qu₂-un-šu-u₂?#-[ma? ...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: He plucked out (his feathers) [and cast him into a pit]."}, {"number": "b+8", "oldLineNumbers": [], "variants": [{"reconstruction": "%n ašar (|) mū[t (|) ...]", "manuscripts": [{"manuscriptId": 1, "labels": ["v"], "number": "8'", "atf": "a-ša-ar mu-u₂#-[ut ...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": true, "isBeginningOfSection": false, "translation": "#tr.en: A place of dea[th by starvation and thirst]."}, {"number": "b+9", "oldLineNumbers": [], "variants": [{"reconstruction": "%n paʾāṣiš | er[îm ...]\n#note: On @i{paʾāṣiš} as “for chrushing” see now @bib{eda1-1@112}.", "manuscripts": [{"manuscriptId": 1, "labels": ["v"], "number": "9'", "atf": "pa-ʾa₄-ṣi₂-iš e-r[i-im ...]", "omittedWords": []}], "intertext": ""}], "isSecondLineOfParallelism": false, "isBeginningOfSection": false, "translation": "#tr.en: @i{Being thus crushed} the eag[le ...]."}, {"number": "b+10", "oldLineNumbers": [], "variants": [{"reconstruction": "%n išpil | ... [...]", "manuscripts": [{"manuscriptId": 1, "labels": ["v"], "number": "10'", "atf": "iš-pi-il ši-i[d/d[a-...]", "omitted